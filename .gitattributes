# ============================================================
# 换行符与文件类型规范
#   - 仓库内文本一律 LF（避免每次 commit 刷 CRLF 警告）
#   - Windows 脚本保持 CRLF，免得某些工具解析异常
#   - 二进制文件禁止做换行转换
# ============================================================

* text=auto eol=lf

*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.eot   binary
*.pdf   binary
