# ============================================================
# Hexo 博客 —— 版本控制忽略清单
# 说明：以下路径均为「可重新生成」或「本机专用」，不应进入仓库。
# ============================================================

# ---- 依赖（用 npm install 还原）----
node_modules/

# ---- 构建产物（用 hexo generate 还原）----
public/
db.json

# ---- 部署工作目录（用 hexo deploy 重建）----
.deploy_git/

# ---- 维护脚本产生的临时快照 ----
_audit/

# ---- 壁纸自动下载的原始大图（4K 每张 3~4MB，不入库）----
# 只提交 tools/update-covers.ps1 裁剪后的小图（featureimages / banner）
assets/incoming/

# ---- 日志 ----
*.log
npm-debug.log*
yarn-error.log*

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器 ----
.idea/
*.swp
*.swo
*~
